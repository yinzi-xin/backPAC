    "#Define wavefront matching loss function\n",
    "@eqx.filter_jit\n",
    "@eqx.filter_value_and_grad\n",
    "def loss_fn_WFM(params, mplc_system):\n",
    "\n",
    "    #make the actual feature resolution 2x the simulation resolution\n",
    "    phase_screens = params[\"phase_screens\"]\n",
    "    n = phase_screens.shape[-1]\n",
    "    binned_phase_screens = bin_phase_screens(phase_screens, bin_size=2)\n",
    "    filtered_phase_screens = mask_to_beam_size(binned_phase_screens, npixels=n, diameter=diameter, array_diameter=simulation_diameter)\n",
    "\n",
    "    mplc_system = mplc_system.set(\"mplc.phase_screens\", filtered_phase_screens)\n",
    "    mplc_system = mplc_system.set(\"mplc.total_length\", params[\"total_length\"])\n",
    "\n",
    "    #propagate every input mode through the MPLC system\n",
    "    res = mplc_system()\n",
    "\n",
    "    #calculate the loss (summed over wavelengths and modes)\n",
    "    #expand the target modes to match the shape of res\n",
    "    target_modes_expanded = np.expand_dims(mplc_system.target_modes, axis=1)\n",
    "\n",
    "    #calculate the overlap integral between the output modes and the target modes\n",
    "    overlap = np.sum(np.conj(res) * target_modes_expanded, axis=(-2, -1))\n",
    "\n",
    "    #calculate the loss as 1 - the mean of the squared magnitude of the overlap\n",
    "    loss = 1 - np.mean(np.abs(overlap)**2)\n",
    "    return loss\n"
